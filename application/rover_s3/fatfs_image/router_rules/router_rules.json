{
  "version": 1,
  "rules": [
    {
      "id": "voice_direct",
      "match": {"source_channel": "voice", "content_type": "direct"},
      "action": {"type": "drop"}
    },
    {
      "id": "voice_llm",
      "match": {"source_channel": "voice"},
      "action": {"type": "submit_to_agent"},
      "reply_channel": "voice"
    },
    {
      "id": "tg_llm",
      "match": {"source_channel": "telegram"},
      "action": {"type": "submit_to_agent"},
      "reply_channel": "telegram"
    },
    {
      "id": "tg_outbound",
      "match": {"event_type": "out_message", "target_channel": "telegram"},
      "action": {"type": "call_cap", "cap_id": "tg_send_message"}
    }
  ]
}
