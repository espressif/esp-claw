menu "Rover S3 Configuration"

config ROVER_S3_WIFI_SSID
    string "Default Wi-Fi SSID"
    default ""

config ROVER_S3_WIFI_PASSWORD
    string "Default Wi-Fi password"
    default ""

config ROVER_S3_LLM_API_KEY
    string "Default LLM API key"
    default ""

config ROVER_S3_LLM_BACKEND_TYPE
    string "Default LLM backend type"
    default "openai_compatible"

config ROVER_S3_LLM_PROFILE
    string "Default LLM profile"
    default "openai"

config ROVER_S3_LLM_MODEL
    string "Default LLM model"
    default "openrouter/auto"

config ROVER_S3_LLM_BASE_URL
    string "Default LLM base URL"
    default "https://openrouter.ai/api/v1"

config ROVER_S3_LLM_AUTH_TYPE
    string "Default LLM auth type"
    default "bearer"

config ROVER_S3_LLM_TIMEOUT_MS
    string "Default LLM timeout ms"
    default "30000"

config ROVER_S3_TG_BOT_TOKEN
    string "Default Telegram bot token"
    default ""

config ROVER_S3_TIME_TIMEZONE
    string "Default timezone (POSIX TZ string)"
    default "UTC0"

endmenu

# rover_s3 is a hand-rolled PlatformIO app (no `idf.py bmgr` board-manager
# Kconfig generation), so board-capability symbols that generated Kconfig
# normally provides don't exist here. app_claw's idf_component.yml gates the
# optional system_ui component on this symbol; stub it to n (with a prompt
# string, required for the component manager's rule evaluator to resolve the
# symbol instead of erroring on an undefined one) so dependency resolution
# succeeds.
config ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT
    bool "Board has an LCD display (stub; rover_s3 does not run idf.py bmgr)"
    default n
