
# RockBase-iot NM-Display-28inch board defaults
# SoC: ESP32-S3 (16 MB QIO Flash + 8 MB OPI PSRAM)

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash: 16 MB, QIO 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Use the board-specific 16 MB partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# Octal PSRAM, 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Enable display_lcd device support for the ST7789 SPI panel
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y

# Camera: OV2640 DVP 8-bit (OV series per hardware README)
CONFIG_ESP_BOARD_DEV_CAMERA_SUPPORT=y
CONFIG_APP_CLAW_LUA_MODULE_CAMERA=y
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y
CONFIG_CAMERA_OV2640=y

# Size-optimised build; move FreeRTOS and ring-buffer code out of IRAM to free
# space for the LCD framebuffer, and reduce Wi-Fi IRAM usage similarly.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_SNAPSHOT_FUNCS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# USB: Serial JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
