# LCKFB SZPI ESP32-S3 (立创·实战派 ESP32-S3)
# Module: ESP32-S3-WROOM-1-N16R8 (16 MB flash, 8 MB octal PSRAM)

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 16 MB QIO flash @ 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# 8 MB octal PSRAM @ 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Console: UART0 (on-board CH340K) is the primary channel. The native USB
# Serial/JTAG port is also enabled as a secondary console, so logs are visible
# on either of the two Type-C data ports.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# LCD Lua module (standalone ST7789 panel bring-up). Touch, audio, camera and
# vision Lua modules are enabled automatically once their board devices exist.
CONFIG_APP_CLAW_LUA_MODULE_LCD=y

# On-board QMI8658 IMU backend
CONFIG_APP_CLAW_LUA_MODULE_IMU=y
CONFIG_LUA_MODULE_IMU_CHIP_QMI8658=y

# Camera: DVP interface. Support both the stock GC0308 and the GC2145 module
# (both are auto-detected over SCCB). XCLK is 20 MHz, matching the
# esp_cam_sensor DVP format definitions for these sensors.
CONFIG_ESP_VIDEO_ENABLE_DVP_VIDEO_DEVICE=y

CONFIG_CAMERA_GC0308=y
CONFIG_CAMERA_GC0308_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC0308_DVP_RGB565_BE_640X480_16FPS=y
CONFIG_CAMERA_GC0308_DVP_DEFAULT_FMT_RGB565_BE_640X480_16FPS=y

CONFIG_CAMERA_GC2145=y
CONFIG_CAMERA_GC2145_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_GC2145_DVP_RGB565_BE_640X480_15FPS=y
CONFIG_CAMERA_GC2145_DVP_DEFAULT_FMT_RGB565_BE_640X480_15FPS=y
