flowchart TB
      subgraph L1["Layer 1 — orchestrator"]
          Q[UserInput / Command / Event Queue]
          RO[Orchestrator::tick]
      end
      subgraph L2["Layer 2 — agent"]
          REG[AgentRegistry]
          SPEC[AgentSpec trait]
          FE[FrontendAgentSpec]
          WK[WorkerAgentSpec]
          PATCH[StatePatch / apply_patches]
      end
      subgraph L2b["Layer 2 — context"]
          CTX[ContextAssembler]
      end
      subgraph L3["Layer 3 — iteration_loop + runtime"]
          RT[run_iteration]
          IL[IterationLoop::run]
          LLM[ClawApi]
          CAP[CapabilityInvoker]
      end
      Q --> RO
      RO --> REG
      REG --> SPEC
      SPEC --> FE
      SPEC --> WK
      RO --> CTX
      CTX --> SPEC
      RO --> RT
      RT --> IL
      IL --> LLM
      IL --> CAP
      IL --> RT
      RT --> SPEC
      SPEC --> PATCH
      PATCH --> RO