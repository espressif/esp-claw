/*
 * Copy this file to `test_secrets.h` (gitignored) and fill in real values.
 * The on-device tests need Wi-Fi to reach a live HTTP endpoint.
 */
#pragma once

/* Wi-Fi STA credentials (WPA2-PSK). */
#define TEST_WIFI_SSID "your-ssid"
#define TEST_WIFI_PASS "your-password"

/*
 * An endpoint that accepts a JSON POST and answers HTTP 200. httpbin echoes the
 * request, which is ideal. Used by the synchronous ClawHttp test.
 */
#define TEST_HTTP_URL "https://httpbin.org/post"

/*
 * HTTPS endpoint for the async test. esp_http_client's non-blocking mode (used
 * by the async ClawHttpAsync driver) is HTTPS-only, so this MUST be https://.
 */
#define TEST_HTTPS_URL "https://httpbin.org/post"
