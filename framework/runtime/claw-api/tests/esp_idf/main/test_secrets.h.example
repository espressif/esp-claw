/*
 * Copy this file to `test_secrets.h` (gitignored) and fill in real values.
 * The on-device test needs Wi-Fi and a live OpenAI-compatible LLM endpoint.
 */
#pragma once

/* Wi-Fi STA credentials (WPA2-PSK). */
#define TEST_WIFI_SSID "your-ssid"
#define TEST_WIFI_PASS "your-password"

/*
 * OpenAI-compatible chat-completions base URL. Do NOT include the
 * `/chat/completions` suffix -- claw-api appends it. Example: the OpenAI v1 root.
 */
#define TEST_LLM_BASE_URL "https://api.openai.com/v1"

/* Bearer API key for the endpoint above. */
#define TEST_LLM_API_KEY "sk-..."

/* Model id to request. */
#define TEST_LLM_MODEL "gpt-4o-mini"
