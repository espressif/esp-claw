# Watchdog off: a live LLM round-trip over TLS can hold the main task for a while.
# CONFIG_ESP_TASK_WDT_INIT is not set

# Custom partition table with a large factory app (Rust std + claw-api + TLS + Wi-Fi).
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The partition table needs >2MB; use 4MB flash (matches most esp32s3 devkits).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# The Rust esp_http_client driver attaches the cert bundle for HTTPS.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# The chat case runs on the main task; give it headroom for the TLS call plus
# JSON (de)serialization of the request/response.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
