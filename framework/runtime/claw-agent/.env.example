# Copy this file to `.env.local` and fill in values for live `iteration_loop` tests.
#
#   cp .env.example .env.local
#
# Mocked unit tests do not need these. The live integration test
# `live_plain_text_when_api_key_configured` fails if this file or
# `CLAW_LLM_API_KEY` is missing.

CLAW_LLM_API_KEY=
CLAW_LLM_BASE_URL=https://api.openai.com
CLAW_LLM_MODEL=gpt-4o-mini
